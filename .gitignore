node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store

# The phase-zero spike is kept as documentation, its dependencies are not.
spike/node_modules/

# Corpus fetched from real pages: useful locally, not ours to redistribute.
packages/core/test/fixtures/local/*
!packages/core/test/fixtures/local/.gitkeep

# The build output of the corpus, which lists every page it collected: urls,
# WARC offsets, hashes. Addresses rather than content, but still a record of
# other people's sites, and there is no reason for it to live here. What is
# committed is the recipe — corpus/seeds.json — and the aggregate numbers, in
# README.md and docs/corpus.md. Nothing per-page.
corpus/corpus.lock.json

# Benchmark output. Every answer key and every answer in there was derived from
# a corpus page, so the directory is other people's content by another route,
# and disagreements.md quotes it directly. What may be committed is the
# aggregate: the tables in README.md and docs/bench.md, and the numbers in
# corpus/bench-baselines.json.
#
# The trailing glob matters. A run under a different model or an older library
# gets kept beside the current one — `bench-results-haiku`, `bench-results-v1` —
# and each copy is every bit as much other people's content as the live one.
bench-results*/

# May hold a registry token.
.npmrc
